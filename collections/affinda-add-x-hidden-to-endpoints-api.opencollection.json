          "docs": "Create a new organization."
        },
        {
          "info": {
            "name": "Update an organization",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{region}.affinda.com/v3/organizations/:identifier",
            "params": [
              {
                "name": "identifier",
                "value": "",
