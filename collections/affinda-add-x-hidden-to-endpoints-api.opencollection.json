          "docs": "The admin users can use this endpoint to update the role of the members within their organization."
        },
        {
          "info": {
            "name": "Delete an organization membership",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{region}.affinda.com/v3/organization_memberships/:identifier",
            "params": [
              {
                "name": "identifier",
                "value": "",
                "type": "path",
                "description": "Membership identifier."
